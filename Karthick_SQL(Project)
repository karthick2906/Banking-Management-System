----Inner_Join

select 
c.customer_name,
a.account_id,
a.account_type,
a.balance
from customers c
inner join accounts a
on c.customer_id = a.customer_id;

----Left_Join

select 
c.customer_name,
a.account_id,
a.account_type
from customers c
left join accounts a
on c.customer_id = a.customer_id;

----Right_Join

select 
c.customer_name,
a.account_id,
a.balance
from customers c
right join accounts a
on c.customer_id = a.customer_id;

----Multiple_table_join

select 
c.customer_name,
b.branch_name,
a.account_type,
a.balance,
l.loan_type,
l.loan_amount
from customers c
left join branches b
on c.branch_id = b.branch_id
left join accounts a
on c.customer_id = a.customer_id
left join loans l
on c.customer_id = l.customer_id;

-----sum of customers balance Group_By

select c.customer_name,
       sum(a.balance) as total_balance
from customers c
inner join accounts a
on c.customer_id = a.customer_id
group by c.customer_name;

----Avg of customers balance and Having

select c.customer_name,
       avg(a.balance) as avg_balance
from customers c
inner join accounts a
on c.customer_id = a.customer_id
group by c.customer_name
having avg(a.balance) > 40000;

-----maximam of customers balance and Order by

select c.customer_name,
       max(a.balance) as highest_balance
from customers c
inner join accounts a
on c.customer_id = a.customer_id
group by c.customer_name
order by highest_balance desc;


